SELECT COUNT(*) AS total_races
FROM races
JOIN circuits
ON races.circuitId = circuits.circuitId
WHERE circuits.name = 'Silverstone Circuit';

SELECT forename, results.position from results
join drivers on results.driverId = drivers.driverId
join races on results.raceId = races.raceId
JOIN circuits
  ON races.circuitId = circuits.circuitId
WHERE races.year = 2016
  AND circuits.name = 'Yas Marina Circuit';
















SELECT forename, results.fastestLap, circuits.name from drivers
JOIN results on drivers.driverId = results.driverId
JOIN races on results.raceId=races.raceId
JOIN circuits on races.circuitId=circuits.circuitId
WHERE races.year = '2016'
AND drivers.forename = 'Max'
ORDER BY results.position DESC;

SELECT forename, pitstops.duration, races.year from drivers
join pitstops on drivers.driverId = pitstops.driverId
join laptimes on drivers.driverId= laptimes.driverId
join races on laptimes.raceId=races.raceId
GROUP BY drivers.forename
ORDER BY pitstops.duration DESC;


select constructors.name, count(races.raceId) as Number_of_races from constructors
join constructor_results on constructors.constructorid = constructor_results.constructorid
join races on constructor_results.raceId=races.raceId
group by constructors.name
order by count(races.raceId) ASC;